APP_NAME="日记Planner"
APP_DESCRIPTION="把日子写进计划里。"
APP_LOCALE=zh-CN
APP_THEME=cream
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Shanghai
SESSION_SECURE=true

# Cloudflare Turnstile 登录人机验证；Site Key 与 Secret Key 都填才会启用。
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 允许的登录域名，逗号分隔；留空时使用 APP_URL 的主机名。
TURNSTILE_HOSTNAMES=
TURNSTILE_ACTION=login

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mini_blogplanner
DB_USER=cream
DB_PASSWORD=

# Absolute path to the directory that contains releases/, current, previous and shared/.
DEPLOY_ROOT=/var/www/blog

# Optional command run after current release switch; clears PHP-FPM/OPcache realpath caches.
# reload 不清 realpath 缓存，生产使用 restart。
# Example: RUNTIME_RELOAD_CMD="systemctl restart php8.5-fpm"
RUNTIME_RELOAD_CMD=

# Used by bin/backup.sh and bin/upgrade.php.
BACKUP_DIR=/var/www/blog/shared/storage/backups
MYSQL_DUMP_BIN=mysqldump
MYSQL_BIN=mysql
