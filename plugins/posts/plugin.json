{
  "id": "posts",
  "name": "Posts",
  "version": "0.2.8",
  "priority": 25,
  "class": "Plugin\\Posts\\PostsPlugin",
  "runtime": true,
  "enabled": true,
  "requires": {
    "php": ">=8.5.0",
