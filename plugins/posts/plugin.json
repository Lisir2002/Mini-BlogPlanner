{
  "id": "posts",
  "name": "Posts",
  "version": "0.2.14",
  "priority": 25,
  "class": "Plugin\\Posts\\PostsPlugin",
  "runtime": true,
  "enabled": true,
  "requires": {
    "php": ">=8.5.0",
    "core": ">=0.1.0"
  },
  "provides": [
    "posts",
    "tags",
    "search",
    "feed",
    "archive"
  ],
  "routes": [
    "/archive",
    "/archive/{year}",
    "/archive/{year}/{month}",
    "/archive/{year}/{month}/page/{page}",
    "/feed",
    "/feed.xml",
    "/atom.xml",
    "/feed.json",
    "/search",
    "/posts",
    "/posts/{slug}"
  ],
  "route_prefixes": [
    "/archive",
    "/posts",
    "/search"
  ],
  "migrations": false,
  "hooks": []
}
