{
  "id": "api",
  "name": "HTTP API",
  "version": "0.2.2",
  "priority": 30,
  "class": "Plugin\\Api\\ApiPlugin",
  "runtime": true,
  "enabled": true,
  "requires": {
    "php": ">=8.5.0",
    "core": ">=0.1.0"
  },
  "provides": [
    "json-api"
  ],
  "routes": [
    "/api/v1/health",
    "/api/v1/search",
    "/api/v1/series",
    "/healthz"
  ],
  "route_prefixes": [
    "/api/",
    "/healthz"
  ],
  "migrations": false,
  "hooks": []
}
